# ThingSpeak Integration (Optional - leave blank to run in demo mode)
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_WRITE_API_KEY=

# Flask Settings
FLASK_SECRET_KEY=change-me-to-a-random-secret-key
FLASK_DEBUG=false
FLASK_PORT=5000

# Field Mapping for ThingSpeak Channel (verify with your channel)
THINGSPEAK_FIELD_VOLTAGE=field1
THINGSPEAK_FIELD_CURRENT=field2
THINGSPEAK_FIELD_POWER=field3
THINGSPEAK_FIELD_ENERGY=field4
